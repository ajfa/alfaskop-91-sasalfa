+void a91_state::line2_tbit(int bit)
+{
+	// characters go out LSB first: after SYN SYN the window holds 0x1616, then every 8 bits a character
+	m_l2_tsr = (m_l2_tsr >> 1) | (bit ? 0x8000 : 0);
+	if (m_l2_tcount < 0)
+	{
+		if (m_l2_tsr == 0x1616)
+			m_l2_tcount = 0;
+		return;
+	}
+	if (++m_l2_tcount < 8)
+		return;
+	m_l2_tcount = 0;
+	u8 const c = m_l2_tsr >> 8;
+	if (c == 0xff)
+	{
+		// marking: the transmitter has stopped
+		m_l2_tcount = -1;
+		return;
+	}
+	LOGX21("%.6f LINE2 tx %02X\n", machine().time().as_double(), c);
+	if ((c & 0x7f) != 0x16)
+		m_l2_out.push_back(c & 0x7f);
+}
+
+int a91_state::line2_next_rbit()
+{
+	if (!m_l2_rbits)
+	{
+		if (m_l2_rxq.empty())
+		{
+			if (m_l2_idle < 16)
+				m_l2_idle++;
+			return 1;
+		}
+		u8 const c = m_l2_rxq.front() & 0x7f;
+		m_l2_rxq.pop_front();
+		// odd parity in bit 7
+		m_l2_rsr = c | ((population_count_32(c) & 1) ? 0 : 0x80);
+		m_l2_rbits = 8;
+		m_l2_idle = 0;
+	}
+	int const bit = m_l2_rsr & 1;
+	m_l2_rsr >>= 1;
+	m_l2_rbits--;
+	return bit;
+}
